# Required runtime settings
# Mainnet-only runtime.
BANKOFAI_ENV=prod
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Optional runtime settings
# Optional manual override. Leave empty to use the default RPC for the selected BANKOFAI_ENV.
TRON_RPC_URL=
# Public base URL used in x402 resource metadata. Set this behind gateways that reject localhost/private URLs.
PUBLIC_RESOURCE_BASE_URL=
# x402 settlement endpoint.
X402_FACILITATOR_URL=https://facilitator-v2.bankofai.io
# Facilitator auth for higher rate limits. Sent as X-API-KEY.
X402_FACILITATOR_API_KEY=
# Backward-compatible alias. Use X402_FACILITATOR_API_KEY for new deployments.
FACILITATOR_API_KEY=
# BANK OF AI merchant recharge status query auth.
BANKOFAI_MERCHANT_ID=
BANKOFAI_MERCHANT_KEY=
# Timeout for BANK OF AI recharge status API.
BANKOFAI_API_TIMEOUT_SECONDS=10
RATE_LIMIT_PER_MINUTE=120
# Set to the number of trusted proxy hops when deployed behind a gateway/load balancer.
TRUST_PROXY_HOPS=0
# Request limits
REQUEST_BODY_MAX_BYTES=1048576
# Facilitator timeouts/retries
FACILITATOR_TIMEOUT_SECONDS=10
FACILITATOR_VERIFY_RETRIES=1
FACILITATOR_RETRY_BACKOFF_SECONDS=0.5
FACILITATOR_SETTLE_TIMEOUT_SECONDS=120
